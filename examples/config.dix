font = "LythMono Nerd Font";
font_size = 20;
padding_x = 8;
padding_y = 2;

background = "#1e1e2e";
foreground = "#cdd6f4";
cursor    = "#f5e0dc";

// Optional fullscreen post-processing fragment shader (a file path).
// The shader receives the scene as `texture0`, plus `iTime` and `iResolution`.
// custom_shader = "/path/to/effect.fs";

// 16-color palette overrides.
palette = {
  black         = "#45475a";
  red           = "#f38ba8";
  green         = "#a6e3a1";
  yellow        = "#f9e2af";
  blue          = "#89b4fa";
  magenta       = "#f5c2e7";
  cyan          = "#94e2d5";
  white         = "#bac2de";
  bright_black  = "#585b70";
  bright_red    = "#f38ba8";
  bright_green  = "#a6e3a1";
  bright_yellow = "#f9e2af";
  bright_blue   = "#89b4fa";
  bright_magenta = "#f5c2e7";
  bright_cyan   = "#94e2d5";
  bright_white  = "#a6adc8";
};

// vim: ft=nix
